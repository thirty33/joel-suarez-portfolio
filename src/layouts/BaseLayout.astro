---
import "../styles/global.css";
import { CONTACT } from "../data/home";

interface Props {
	title: string;
	description: string;
	/** Preload the hero photos; only the home shows them. */
	preloadHero?: boolean;
}

const { title, description, preloadHero = true } = Astro.props;

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: CONTACT.name,
	jobTitle: "Arquitecto de software",
	areaServed: "Worldwide",
	address: { "@type": "PostalAddress", addressLocality: "Mérida", addressCountry: "VE" },
	knowsAbout: ["Agentes de IA", "WhatsApp Business API", "Pasarelas de pago", "Integraciones con ERP", "Laravel", "React", "AWS"],
	sameAs: [CONTACT.linkedin, CONTACT.github],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>document.documentElement.classList.add("js");</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#050c17" />
		<meta name="facebook-domain-verification" content="tvh5o1gqdjt7g3mozxii8lxg6haa47" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_LA" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/og-image.jpg" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" href="/fonts/anton-latin.woff" as="font" type="font/woff" crossorigin />
		<link rel="preload" href="/fonts/montserrat-latin.woff" as="font" type="font/woff" crossorigin />
		{preloadHero && (
			<>
				<link rel="preload" as="image" media="(min-width: 1024px)" imagesrcset="/images/joel/workspace-1200.webp 1200w, /images/joel/workspace.webp 2400w" imagesizes="100vw" />
				<link rel="preload" as="image" media="(max-width: 1023.98px)" imagesrcset="/images/joel/portrait-480.webp 480w, /images/joel/portrait.webp 1100w" imagesizes="100vw" />
			</>
		)}
		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
	</head>
	<body class="font-sans antialiased">
		<a href="#contenido" class="skip-link">Saltar al contenido</a>
		<slot />
	</body>
</html>
