---
import Icon from "../Icon.astro";
import Logo from "../Logo.astro";
import { CONTACT, HELLO_MESSAGE, SECTIONS, whatsappLink } from "../../data/home";
import { at } from "../../lib/grid";

const year = new Date().getFullYear();
---

<footer class="relative overflow-clip bg-lemon text-ink shell grid-rows-[3.5rem_auto_3rem_auto_2.5rem_auto_1.75rem] lg:grid-rows-[5rem_auto_4rem_auto_3.5rem_auto_2rem]" data-theme="light">
	<!-- Brand, sections and back to top -->
	<div class="col-start-2 row-start-2 grid grid-rows-[auto_2rem_auto] lg:grid-cols-[auto_minmax(2rem,1fr)_auto_3rem_auto] lg:grid-rows-1 lg:items-center">
		<a href="#inicio" class="row-start-1 justify-self-start">
			<Logo size="lg" markClass="text-ink" />
			<span class="sr-only">, volver al inicio</span>
		</a>
		<nav class="row-start-3 lg:col-start-3 lg:row-start-1" aria-label="Secciones del pie">
			<ul class="footer-nav">
				{SECTIONS.map((section, index) => (
					<li class="footer-nav-item" style={`--col:${index < 4 ? 1 : 3}; --row:${at(index % 4)}; --lg-col:${at(index)}`}>
						<a class="nav-link text-[0.92rem] font-bold text-ink/75 hover:text-ink" href={`#${section.id}`}>{section.label}</a>
					</li>
				))}
			</ul>
		</nav>
		<a href="#inicio" class="group hidden h-14 w-14 place-items-center rounded-full bg-ink text-lemon transition-transform duration-300 hover:-translate-y-1 lg:col-start-5 lg:row-start-1 lg:grid" aria-label="Volver arriba">
			<span class="rotate-180"><Icon name="arrow-down" size={22} stroke={2.4} /></span>
		</a>
	</div>

	<!-- The last call, as big as the brand -->
	<a
		class="footer-cta group col-start-2 row-start-4 grid grid-cols-[minmax(0,1fr)_auto] grid-rows-[clamp(0.6rem,1.4vw,1.2rem)_auto_clamp(1rem,2.8vw,2.4rem)] items-center border-y-2 border-ink"
		href={whatsappLink(HELLO_MESSAGE)}
		target="_blank"
		rel="noopener"
	>
		<span class="display col-start-1 row-start-2 text-[clamp(3.2rem,13.5vw,12.5rem)] leading-[0.86]">
			<span class="footer-cta__text">¿Hablamos?</span>
		</span>
		<span class="col-start-2 row-start-2 grid h-[clamp(3.4rem,9vw,8rem)] w-[clamp(3.4rem,9vw,8rem)] place-items-center rounded-full bg-ink text-lemon transition-transform duration-500 group-hover:rotate-45">
			<Icon name="arrow-up-right" size={44} stroke={2.2} class="h-1/2 w-1/2" />
		</span>
	</a>

	<!-- Fine print -->
	<div class="col-start-2 row-start-6 grid grid-rows-[auto_1rem_auto] text-[0.82rem] font-semibold text-ink/70 md:grid-cols-[auto_1fr_auto] md:grid-rows-1 md:items-center">
		<p class="row-start-1 md:col-start-1">© {year} {CONTACT.name} · {CONTACT.city}</p>
		<div class="row-start-3 grid grid-cols-[auto_1.1rem_auto_1.1rem_auto_1.1rem_auto] items-center justify-start md:col-start-3 md:row-start-1">
			<a class="col-start-1 hover:text-ink" href={`mailto:${CONTACT.email}`} aria-label="Correo"><Icon name="mail" size={20} /></a>
			<a class="col-start-3 hover:text-ink" href={CONTACT.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
			<a class="col-start-5 hover:text-ink" href={CONTACT.github} target="_blank" rel="noopener" aria-label="GitHub"><span class="ico" style="--ico:url(/icons/github.svg); --ico-size:1.2rem"></span></a>
			<a class="col-start-7 hover:text-ink" href={whatsappLink(HELLO_MESSAGE)} target="_blank" rel="noopener" aria-label="WhatsApp"><span class="ico" style="--ico:url(/icons/whatsapp.svg); --ico-size:1.2rem"></span></a>
		</div>
	</div>
</footer>
