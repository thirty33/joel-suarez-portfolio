---
import Icon from "../Icon.astro";
import { CONTACT, COUNTRIES, HELLO_MESSAGE, SERVICE_OPTIONS, whatsappLink } from "../../data/home";

const phone = `+${CONTACT.whatsapp.slice(0, 2)} ${CONTACT.whatsapp.slice(2, 5)} ${CONTACT.whatsapp.slice(5, 8)} ${CONTACT.whatsapp.slice(8)}`;

const CHANNELS = [
	{ label: "WhatsApp", value: phone, href: whatsappLink(HELLO_MESSAGE), icon: "/icons/whatsapp.svg", tone: "bg-[#25d366] text-white" },
	{ label: "Correo", value: CONTACT.email, href: `mailto:${CONTACT.email}`, icon: null, tone: "bg-lemon text-ink" },
	{ label: "LinkedIn", value: "in/thirty33", href: CONTACT.linkedin, icon: null, tone: "bg-[#0a66c2] text-white" },
	{ label: "GitHub", value: "github.com/thirty33", href: CONTACT.github, icon: "/icons/github.svg", tone: "bg-white text-ink" },
];
---

<section id="contacto" class="relative isolate overflow-clip bg-ink text-white shell grid-rows-[5rem_auto_6rem] lg:grid-rows-[8rem_auto_8.5rem]" aria-labelledby="contacto-title" data-motion data-theme="dark">
	<img src="/images/joel/desk.webp" width="1920" height="840" alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-30 h-full w-full object-cover object-[28%_50%] opacity-[0.18]" aria-hidden="true" />
	<div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(5,12,23,.92)_0%,rgba(5,12,23,.7)_45%,rgba(5,12,23,.92)_100%)]" aria-hidden="true"></div>
	<div class="hero__glow -right-[14rem] -top-[12rem] -z-10 h-[42rem] w-[42rem]" aria-hidden="true"></div>
	<p class="ghost absolute -bottom-[0.12em] -left-[0.04em] -z-10 text-[clamp(6rem,20vw,19rem)]" style="--ghost-stroke:rgba(242,233,109,.1)" aria-hidden="true" data-ghost>Hablemos</p>

	<div class="col-start-2 row-start-2 grid grid-rows-[auto_3.5rem_auto] lg:grid-cols-[minmax(0,1fr)_4.5rem_minmax(0,31rem)] lg:grid-rows-1 lg:items-center">
		<!-- Words and direct channels -->
		<div class="row-start-1 grid grid-rows-[auto_1.25rem_auto_1.25rem_auto_2.25rem_auto] lg:col-start-1" data-reveal>
			<p class="row-start-1 grid grid-cols-[auto_0.85rem_2.75rem_0.85rem_auto] items-center justify-start">
				<span class="col-start-1 font-display text-[1.5rem] leading-none text-lemon">07</span>
				<span class="col-start-3 h-[2px] bg-white/30"></span>
				<span class="eyebrow col-start-5 text-white/70">Contacto</span>
			</p>
			<h2 id="contacto-title" class="display row-start-3 text-[3.1rem] leading-[1.06] text-balance sm:text-[4rem] lg:text-[5rem]">¿Lo construimos <span class="hl">juntos?</span></h2>
			<p class="row-start-5 max-w-[34rem] text-[1.02rem] leading-relaxed text-white/75 text-pretty lg:text-[1.1rem]">
				Cuéntame qué se hace a mano en tu empresa o qué quieres vender en línea. Te respondo con una propuesta concreta: qué construir primero, en cuánto tiempo y cómo lo vas a medir.
			</p>
			<ul class="row-start-7 grid grid-rows-[auto_0.75rem_auto_0.75rem_auto_0.75rem_auto] sm:grid-cols-[1fr_1rem_1fr] sm:grid-rows-[auto_0.75rem_auto] lg:grid-cols-1 lg:grid-rows-[auto_0.75rem_auto_0.75rem_auto_0.75rem_auto]">
				{CHANNELS.map((channel, index) => {
					const place = [
						"row-start-1 sm:col-start-1 sm:row-start-1 lg:row-start-1",
						"row-start-3 sm:col-start-3 sm:row-start-1 lg:col-start-1 lg:row-start-3",
						"row-start-5 sm:col-start-1 sm:row-start-3 lg:row-start-5",
						"row-start-7 sm:col-start-3 sm:row-start-3 lg:col-start-1 lg:row-start-7",
					][index];
					return (
						<li class={place}>
							<a
								class="card-spot group grid grid-cols-[0.75rem_2.6rem_0.85rem_minmax(0,1fr)_0.5rem_auto_1rem] grid-rows-[0.75rem_auto_0.75rem] items-center rounded-[18px] bg-white/[0.05] ring-1 ring-white/10 transition-colors hover:bg-white/[0.09]"
								href={channel.href}
								target={channel.href.startsWith("mailto:") ? undefined : "_blank"}
								rel="noopener"
								data-spot
							>
								<span class:list={["col-start-2 row-start-2 grid h-[2.6rem] w-[2.6rem] place-items-center rounded-full", channel.tone]}>
									{channel.icon ? <span class="ico" style={`--ico:url(${channel.icon}); --ico-size:1.15rem`}></span> : <Icon name={channel.label === "Correo" ? "mail" : "linkedin"} size={18} />}
								</span>
								<span class="col-start-4 row-start-2 grid min-w-0 grid-rows-[auto_0.15rem_auto]">
									<span class="row-start-1 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-white/50">{channel.label}</span>
									<span class="row-start-3 truncate text-[0.92rem] font-semibold">{channel.value}</span>
								</span>
								<span class="col-start-6 row-start-2 text-white/40 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-lemon"><Icon name="arrow-up-right" size={18} stroke={2.4} /></span>
							</a>
						</li>
					);
				})}
			</ul>
		</div>

		<!-- The form writes the message; WhatsApp or the mail app sends it -->
		<form
			class="glass glass--dark row-start-3 grid rounded-[28px] grid-cols-[1.4rem_minmax(0,1fr)_1.4rem] grid-rows-[1.6rem_auto_0.5rem_auto_1.5rem_auto_1.1rem_auto_1.1rem_auto_1.6rem_auto_0.9rem_auto_1.6rem] lg:col-start-3 lg:row-start-1 lg:grid-cols-[2rem_minmax(0,1fr)_2rem] lg:grid-rows-[2rem_auto_0.5rem_auto_1.6rem_auto_1.1rem_auto_1.1rem_auto_1.75rem_auto_0.9rem_auto_2rem]"
			data-contact-form
			data-reveal="zoom"
			novalidate
		>
			<h3 class="col-start-2 row-start-2 text-[1.45rem] font-extrabold">Cuéntame tu proyecto</h3>
			<p class="col-start-2 row-start-4 text-[0.85rem] leading-relaxed text-white/60">Al enviar se abre WhatsApp con el mensaje ya escrito. Este sitio no guarda tus datos.</p>

			<div class="col-start-2 row-start-6 grid grid-rows-[auto_1.1rem_auto] sm:grid-cols-[1fr_1rem_1fr] sm:grid-rows-1">
				<label class="row-start-1 grid grid-rows-[auto_0.45rem_auto] sm:col-start-1">
					<span class="row-start-1 text-[0.78rem] font-semibold text-white/70">Tu nombre *</span>
					<input class="field row-start-3" type="text" name="name" autocomplete="name" placeholder="Marcela Rojas" required />
				</label>
				<label class="row-start-3 grid grid-rows-[auto_0.45rem_auto] sm:col-start-3 sm:row-start-1">
					<span class="row-start-1 text-[0.78rem] font-semibold text-white/70">Empresa</span>
					<input class="field row-start-3" type="text" name="company" autocomplete="organization" placeholder="Opcional" />
				</label>
			</div>

			<div class="col-start-2 row-start-8 grid grid-rows-[auto_1.1rem_auto] sm:grid-cols-[1fr_1rem_1fr] sm:grid-rows-1">
				<label class="row-start-1 grid grid-rows-[auto_0.45rem_auto] sm:col-start-1">
					<span class="row-start-1 text-[0.78rem] font-semibold text-white/70">País</span>
					<select class="field row-start-3" name="country">
						{COUNTRIES.map((country) => <option value={country.name}>{country.name}</option>)}
						<option value="">Otro país</option>
					</select>
				</label>
				<label class="row-start-3 grid grid-rows-[auto_0.45rem_auto] sm:col-start-3 sm:row-start-1">
					<span class="row-start-1 text-[0.78rem] font-semibold text-white/70">¿Qué necesitas?</span>
					<select class="field row-start-3" name="service">
						{SERVICE_OPTIONS.map((option) => <option value={option}>{option}</option>)}
					</select>
				</label>
			</div>

			<label class="col-start-2 row-start-10 grid grid-rows-[auto_0.45rem_auto]">
				<span class="row-start-1 text-[0.78rem] font-semibold text-white/70">Cuéntame un poco más *</span>
				<textarea class="field row-start-3 min-h-[7.5rem] resize-y" name="message" rows="4" placeholder="Ej.: recibimos 40 pedidos al día por WhatsApp y los pasamos a mano a una planilla…" required></textarea>
			</label>

			<button class="btn btn--lemon btn-ic col-start-2 row-start-12" type="submit" data-magnetic>
				<span class="ico" style="--ico:url(/icons/whatsapp.svg); --ico-size:1.15rem"></span>
				<span>Enviar por WhatsApp</span>
			</button>

			<p class="col-start-2 row-start-14 min-h-[1.2rem] text-[0.8rem] font-semibold text-lemon" role="status" aria-live="polite" data-contact-status></p>
		</form>
	</div>
</section>
